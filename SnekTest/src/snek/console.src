import snek.any;


externc func putchar(int c) int;
externc func system(char* command) int;


func write(char c) {
	putchar(c);
}

func write(string str) {
	for i : str.length {
		putchar(str[i]);
	}
}

func writeln(string str) {
	for i : str.length {
		putchar(str[i]);
	}
	putchar('\n');
}

func write(char* str) int {
	int i = 0;
	while str[i] {
		putchar(str[i++]);
	}
	return i;
}

func writeln(char* str) int {
	int i = 0;
	while str[i] {
		putchar(str[i++]);
	}
	putchar('\n'); i++;
	return i;
}

func write(float f) {
	writeFloat(f);
}

func writeln(float f) {
	writeFloat(f);
	putchar('\n');
}

func write(long i) {
	writeInt(i);
}

func writeln(long i) {
	writeInt(i);
	putchar('\n');
}

func write(ulong u) {
	writeInt(long(u));
}

func writeln(ulong u) {
	writeInt(long(u));
	putchar('\n');
}

func writeInt(long value) {
	if value == 0 {
		putchar('0');
		return;
	}

	char[50] buffer;
	int len = 0;

	bool isNegative = value < 0;
	if isNegative value = -value;

	while value {
		buffer[len++] = char(value % 10 + '0');
		value = value / 10;
	}

	if isNegative
		buffer[len++] = '-';

    for i : len - 1, =0 {
		putchar(buffer[i]);
	}
}

func writeUInt(ulong value) {
	if value == 0 {
		putchar('0');
		return;
	}

	char[50] buffer;
	int len = 0;

	while value {
		buffer[len++] = char(value % 10 + '0');
		value = value / 10u;
	}

    for i : len - 1, =0 {
		putchar(buffer[i]);
	}
}

func writeFloat(double value) {
	long ipart = long(value);
	double fpart = value - ipart;

	writeInt(ipart);
	putchar('.');

	int precision = 6;
	for : precision {
		fpart *= 10;
		int digit = int(fpart);
		putchar('0' + digit);
		fpart -= digit;
	}
}

func writeBoolean(bool b) {
	if b write("true");
	else write("false");
}

func writePointer(void* ptr) {
	return;
}

func writeAny(any value) {
	if (value.type == TypeKind.Int)
		writeInt(int(value));
	else if (value.type == TypeKind.Float)
		writeFloat(float(value));
	else if (value.type == TypeKind.Bool)
		writeBoolean(bool(value));
	else if (value.type == TypeKind.Pointer)
		writePointer(value as void*);
	else if (value.type == TypeKind.String)
		write(string(value));
	else
		putchar('?');
}

func print(string format, any... args) {
	int varArgIdx = 0;
	for i : format.length {
		char c = format[i];
		if (c == '%' && varArgIdx < args.size)
			writeAny(args[varArgIdx++]);
		else
			putchar(c);
	}
}

func println(string format, any... args) {
	print(format, args);
	putchar('\n');
}
