const ulong SDL_WINDOW_FULLSCREEN = (0x0000000000000001);    /**< window is in fullscreen mode */
const ulong SDL_WINDOW_OPENGL = (0x0000000000000002);    /**< window usable with OpenGL context */
const ulong SDL_WINDOW_OCCLUDED = (0x0000000000000004);    /**< window is occluded */
const ulong SDL_WINDOW_HIDDEN = (0x0000000000000008);    /**< window is neither mapped onto the desktop nor shown in the taskbar/dock/window list; SDL_ShowWindow() is required for it to become visible */
const ulong SDL_WINDOW_BORDERLESS = (0x0000000000000010);    /**< no window decoration */
const ulong SDL_WINDOW_RESIZABLE = (0x0000000000000020);    /**< window can be resized */
const ulong SDL_WINDOW_MINIMIZED = (0x0000000000000040);    /**< window is minimized */
const ulong SDL_WINDOW_MAXIMIZED = (0x0000000000000080);    /**< window is maximized */
const ulong SDL_WINDOW_MOUSE_GRABBED = (0x0000000000000100);    /**< window has grabbed mouse input */
const ulong SDL_WINDOW_INPUT_FOCUS = (0x0000000000000200);    /**< window has input focus */
const ulong SDL_WINDOW_MOUSE_FOCUS = (0x0000000000000400);    /**< window has mouse focus */
const ulong SDL_WINDOW_EXTERNAL = (0x0000000000000800);    /**< window not created by SDL */
const ulong SDL_WINDOW_MODAL = (0x0000000000001000);    /**< window is modal */
const ulong SDL_WINDOW_HIGH_PIXEL_DENSITY = (0x0000000000002000);    /**< window uses high pixel density back buffer if possible */
const ulong SDL_WINDOW_MOUSE_CAPTURE = (0x0000000000004000);    /**< window has mouse captured (unrelated to MOUSE_GRABBED) */
const ulong SDL_WINDOW_MOUSE_RELATIVE_MODE = (0x0000000000008000);    /**< window has relative mode enabled */
const ulong SDL_WINDOW_ALWAYS_ON_TOP = (0x0000000000010000);    /**< window should always be above others */
const ulong SDL_WINDOW_UTILITY = (0x0000000000020000);    /**< window should be treated as a utility window, not showing in the task bar and window list */
const ulong SDL_WINDOW_TOOLTIP = (0x0000000000040000);    /**< window should be treated as a tooltip and does not get mouse or keyboard focus, requires a parent window */
const ulong SDL_WINDOW_POPUP_MENU = (0x0000000000080000);    /**< window should be treated as a popup menu, requires a parent window */
const ulong SDL_WINDOW_KEYBOARD_GRABBED = (0x0000000000100000);    /**< window has grabbed keyboard input */
const ulong SDL_WINDOW_VULKAN = (0x0000000010000000);    /**< window usable for Vulkan surface */
const ulong SDL_WINDOW_METAL = (0x0000000020000000);    /**< window usable for Metal view */
const ulong SDL_WINDOW_TRANSPARENT = (0x0000000040000000);    /**< window with transparent buffer */
const ulong SDL_WINDOW_NOT_FOCUSABLE = (0x0000000080000000);    /**< window should not be focusable */

const uint SDL_GPU_SHADERFORMAT_PRIVATE  = (1u << 0); /**< Shaders for NDA'd platforms. */
const uint SDL_GPU_SHADERFORMAT_SPIRV    = (1u << 1); /**< SPIR-V shaders for Vulkan. */
const uint SDL_GPU_SHADERFORMAT_DXBC     = (1u << 2); /**< DXBC SM5_1 shaders for D3D12. */
const uint SDL_GPU_SHADERFORMAT_DXIL     = (1u << 3); /**< DXIL SM6_0 shaders for D3D12. */
const uint SDL_GPU_SHADERFORMAT_MSL      = (1u << 4); /**< MSL shaders for Metal. */
const uint SDL_GPU_SHADERFORMAT_METALLIB = (1u << 5); /**< Precompiled metallib shaders for Metal. */

const uint SDL_GPU_BUFFERUSAGE_VERTEX                                  = (1u << 0); /**< Buffer is a vertex buffer. */
const uint SDL_GPU_BUFFERUSAGE_INDEX                                   = (1u << 1); /**< Buffer is an index buffer. */
const uint SDL_GPU_BUFFERUSAGE_INDIRECT                                = (1u << 2); /**< Buffer is an indirect buffer. */
const uint SDL_GPU_BUFFERUSAGE_GRAPHICS_STORAGE_READ                   = (1u << 3); /**< Buffer supports storage reads in graphics stages. */
const uint SDL_GPU_BUFFERUSAGE_COMPUTE_STORAGE_READ                    = (1u << 4); /**< Buffer supports storage reads in the compute stage. */
const uint SDL_GPU_BUFFERUSAGE_COMPUTE_STORAGE_WRITE                   = (1u << 5); /**< Buffer supports storage writes in the compute stage. */
