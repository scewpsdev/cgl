struct SDL_VirtualJoystickTouchpadDesc {
	Uint16 nfingers;
	Uint16[3] padding;
}
struct SDL_VirtualJoystickSensorDesc {
	SDL_SensorType type;
	float rate;
}
struct SDL_VirtualJoystickDesc {
	Uint32 version;
	Uint16 type;
	Uint16 padding;
	Uint16 vendor_id;
	Uint16 product_id;
	Uint16 naxes;
	Uint16 nbuttons;
	Uint16 nballs;
	Uint16 nhats;
	Uint16 ntouchpads;
	Uint16 nsensors;
	Uint16[2] padding2;
	Uint32 button_mask;
	Uint32 axis_mask;
	char* name;
	SDL_VirtualJoystickTouchpadDesc* touchpads;
	SDL_VirtualJoystickSensorDesc* sensors;
	byte* userdata;
	func(byte* userdata) Update;
	func(byte* userdata, int player_index) SetPlayerIndex;
	func(byte* userdata, Uint16 low_frequency_rumble, Uint16 high_frequency_rumble) -> bool Rumble;
	func(byte* userdata, Uint16 left_rumble, Uint16 right_rumble) -> bool RumbleTriggers;
	func(byte* userdata, Uint8 red, Uint8 green, Uint8 blue) -> bool SetLED;
	func(byte* userdata, byte* data, int size) -> bool SendEffect;
	func(byte* userdata, bool enabled) -> bool SetSensorsEnabled;
	func(byte* userdata) Cleanup;
}
